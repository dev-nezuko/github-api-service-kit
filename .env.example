PORT=3000
API_VERSION=/api/v1
# Optional server-side credential for GitHub API rate limits.
GITHUB_PERSONAL_ACCESS_TOKEN=
# Override only to point at a stand-in API (tests use a local fake); defaults to https://api.github.com.
GITHUB_API_URL=
# Per-request timeout for GitHub calls, in milliseconds.
GITHUB_TIMEOUT_MS=10000
